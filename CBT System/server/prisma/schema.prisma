generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ── CBT & QUESTION BANK ───────────────────────────────────────
model CbtQuestion {
  id            String   @id @default(uuid())
  examType      String   // "JAMB", "WAEC", "NECO", "INTERNAL"
  subject       String   // "Mathematics", "English", "Physics", "Chemistry", "Biology", "Economics", etc.
  targetClass   String?  // "SSS 3", "JAMB", "GENERAL"
  topic         String
  year          Int?
  difficulty    String   @default("MEDIUM") // "EASY", "MEDIUM", "HARD"
  questionText  String
  options       Json     // Array of { id: "A", text: "..." }
  correctOption String   // "A", "B", "C", "D"
  explanation   String?  // Detailed worked solution & explanation
  authorId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CbtAttempt {
  id               String   @id @default(uuid())
  userId           String
  examType         String
  subject          String
  totalQuestions   Int
  score            Int
  percentage       Float
  timeSpentSeconds Int
  answers          Json     // { [questionId]: { chosen: "B", correct: "A", isCorrect: false } }
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Minimal reference to shared Academy User model
model User {
  id        String       @id @default(uuid())
  username  String       @unique
  email     String       @unique
  password  String
  role      String       @default("STUDENT")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  cbtAttempts CbtAttempt[]
}
