generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  MAIN_ADMIN
}

enum Tier {
  PUBLIC
  UNPAID
  PAID
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  role          Role     @default(STUDENT)
  tier          Tier     @default(UNPAID)
  cookieConsent Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile             Profile?
  permissionOverrides PermissionOverride[]
  enrollments         Enrollment[]
  bookmarks           Bookmark[]
  
  // Relations for messaging and friends
  sentMessages        Message[]            @relation("Sender")
  receivedMessages    Message[]            @relation("Receiver")
  sentFriendships     Friendship[]         @relation("Requester")
  receivedFriendships Friendship[]         @relation("Receiver")
  payments            Payment[]

  // Learning Platform additions
  cbtAttempts           CbtAttempt[]
  assignmentSubmissions AssignmentSubmission[] @relation("StudentSubmissions")
  lessonProgress        LessonProgress[]
}

model Profile {
  id               String    @id @default(uuid())
  surname          String?
  firstName        String?
  fullName         String?
  phone            String?
  dateOfBirth      DateTime?
  avatarUrl        String?
  targetClass      String?   // e.g. "SSS 3", "JAMB UTME Candidate", "WAEC Candidate", "JSS 3"
  selectedSubjects Json?     // e.g. ["Mathematics", "English", "Physics", "Chemistry", "Biology"]
  
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PermissionOverride {
  id     String  @id @default(uuid())
  key    String
  value  Boolean @default(true)
  
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Group {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
}

model Enrollment {
  id      String @id @default(uuid())
  userId  String
  groupId String
  
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Course {
  id          String   @id @default(uuid())
  title       String
  category    String
  subject     String
  description String?
  imageUrl    String?
  isPaid      Boolean  @default(true)
  lessons     Lesson[]
}

model Lesson {
  id              String           @id @default(uuid())
  title           String
  playbackId      String?
  content         String?          // Lesson notes & text
  durationMinutes Int?
  order           Int              @default(1)
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model PastQuestion {
  id            String     @id @default(uuid())
  examType      String
  subject       String
  year          Int
  questionText  String
  options       Json
  correctOption String
  isPaid        Boolean    @default(true)
  bookmarks     Bookmark[]
}

model Bookmark {
  id             String       @id @default(uuid())
  userId         String
  pastQuestionId String
  
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pastQuestion PastQuestion @relation(fields: [pastQuestionId], references: [id], onDelete: Cascade)

  @@unique([userId, pastQuestionId])
}

// ── CBT & QUESTION BANK ───────────────────────────────────────
model CbtQuestion {
  id               String    @id @default(uuid())
  examType         String    // "JAMB", "WAEC", "NECO", "INTERNAL"
  subject          String    // "Mathematics", "English", "Physics", "Chemistry", "Biology", "Economics", etc.
  targetClass      String?   // "SSS 3", "JAMB UTME", "GENERAL"
  topic            String
  subTopic         String?
  syllabusVersion  String?   // e.g. "2024-2027", "Current WAEC SSCE"
  year             Int?      // Verified examination year for official past questions
  difficulty       String    @default("MEDIUM") // "EASY", "MEDIUM", "HARD"
  questionType     String    @default("MULTIPLE_CHOICE") // "MULTIPLE_CHOICE", "THEORY", "FILL_IN_BLANK"
  questionText     String
  options          Json      // Array of { id: "A", text: "..." }
  correctOption    String?   // "A", "B", "C", "D", "E"
  explanation      String?   // Detailed worked solution & explanation
  passageText      String?   // Shared reading comprehension or case study passage
  imageUrl         String?   // Diagrams, charts, tables
  markingGuide     String?   // For theory/essay marking guides

  // Origin & Source Integrity
  origin           String    @default("PRACTICE_QUESTION") // "PAST_QUESTION", "ORIGINAL_PRACTICE", "AI_GENERATED"
  sourceName       String?   // e.g. "Official WAEC SSCE June 2022 Paper 2"
  sourceUrl        String?
  permissionStatus String?   @default("VERIFIED") // "VERIFIED", "ACADEMIC_FAIR_USE", "ORIGINAL", "PENDING_VERIFICATION"

  // Review & Publication Workflow
  status           String    @default("APPROVED") // "DRAFT", "PENDING_REVIEW", "APPROVED", "REJECTED", "ARCHIVED"
  isPublished      Boolean   @default(true)
  reviewNotes      String?
  reviewedBy       String?
  reviewedAt       DateTime?

  // Normalized question text for duplicate detection
  normalizedText   String?

  authorId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([examType, subject])
  @@index([status, isPublished])
}

model CbtSubject {
  id          String     @id @default(uuid())
  name        String     @unique
  code        String?    @unique
  examTypes   Json       // e.g. ["JAMB", "WAEC", "NECO", "INTERNAL"]
  description String?
  icon        String?
  isActive    Boolean    @default(true)
  topics      CbtTopic[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CbtTopic {
  id              String     @id @default(uuid())
  subjectId       String
  name            String
  syllabusVersion String?
  order           Int        @default(1)
  subject         CbtSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([subjectId, name])
}

model CbtImportLog {
  id             String    @id @default(uuid())
  fileName       String
  fileType       String    // "CSV", "JSON", "EXCEL"
  totalRows      Int       @default(0)
  acceptedCount  Int       @default(0)
  skippedCount   Int       @default(0)
  duplicateCount Int       @default(0)
  failedCount    Int       @default(0)
  errors         Json?     // [{ row: 2, error: "Missing option A", raw: "..." }]
  importedBy     String?
  status         String    @default("COMPLETED") // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  createdAt      DateTime  @default(now())
}

model CbtAttempt {
  id               String   @id @default(uuid())
  userId           String
  examType         String
  subject          String
  totalQuestions   Int
  score            Int
  percentage       Float
  timeSpentSeconds Int
  answers          Json     // { [questionId]: { chosen: "B", correct: "A", isCorrect: false } }
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── TIPS LEARNING SYSTEM ──────────────────────────────────────
model Tip {
  id            String   @id @default(uuid())
  title         String
  subject       String
  category      String   // e.g. "Algebra", "Grammar", "Mechanics", "Stoichiometry"
  keyIdea       String
  explanation   String
  example       String?
  memoryTrick   String?  // Mnemonic or mental trigger
  formulaOrRule String?  // Essential rule or mathematical formula
  commonMistake String?  // Common pitfall and how to avoid it
  quickRecall   Json?    // { question: "...", options: ["..."], answer: "..." }
  authorId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── EDUCATIONAL RESOURCE LIBRARY ─────────────────────────────
model Resource {
  id             String   @id @default(uuid())
  title          String
  subject        String
  targetClass    String?  // e.g. "JSS 1-3", "SSS 1-3", "JAMB/WAEC"
  resourceType   String   // "NOTE", "PDF", "WORKSHEET", "REVISION", "TIPS", "GUIDE"
  description    String?
  fileUrl        String
  authorId       String?
  downloadsCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── DIGITAL ASSIGNMENT SYSTEM ────────────────────────────────
model Assignment {
  id          String   @id @default(uuid())
  title       String
  subject     String
  targetClass String   // e.g. "SSS 3", "JSS 2"
  description String
  fileUrl     String?
  dueDate     DateTime?
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id             String   @id @default(uuid())
  assignmentId   String
  studentId      String
  submissionText String?
  fileUrl        String?
  score          Float?
  feedback       String?
  status         String   @default("SUBMITTED") // "SUBMITTED", "GRADED"
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
}

// ── COMMUNITY & NEWS ─────────────────────────────────────────
model News {
  id        String   @id @default(uuid())
  title     String
  tag       String
  date      DateTime @default(now())
  summary   String
  details   String
  imageUrl  String?
}

model Message {
  id         String   @id @default(uuid())
  content    String
  type       String   @default("DIRECT") // e.g. DIRECT, TEACHER_STUDENT
  createdAt  DateTime @default(now())

  senderId   String
  receiverId String
  sender     User     @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Friendship {
  id          String   @id @default(uuid())
  status      String   @default("PENDING") // PENDING, ACCEPTED, BLOCKED
  createdAt   DateTime @default(now())

  requesterId String
  receiverId  String
  requester   User     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model AdSetting {
  id       String  @id @default(uuid())
  slot     String  @unique
  clientId String
  isActive Boolean @default(true)
  price    Float?
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  type      String   // e.g. 'premium_access'
  status    String   @default("SUCCESS") // PENDING, SUCCESS, FAILED
  reference String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
