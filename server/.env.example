# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/stlawrence?schema=public"

# Authentication & Security Secrets (Generate a 64-character random string in production)
JWT_SECRET="your_strong_random_jwt_secret_here"
ADMIN_PASSWORD="your_strong_admin_portal_password"

# Server Port & Allowed Frontend Domain
PORT=5000
FRONTEND_URL="https://your-frontend-domain.com"
NODE_ENV="production"

# Paystack Payment Gateway API Keys
PAYSTACK_SECRET_KEY="sk_live_or_test_key_here"
PAYSTACK_PUBLIC_KEY="pk_live_or_test_key_here"
